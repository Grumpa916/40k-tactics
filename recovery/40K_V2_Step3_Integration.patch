diff --git a/src/rules/tyranid-decision-reminders.js b/src/rules/tyranid-decision-reminders.js
new file mode 100644
index 0000000..cd7fbe3
--- /dev/null
+++ b/src/rules/tyranid-decision-reminders.js
@@ -0,0 +1,116 @@
+import { getTyranidDatasheetDetails } from "../data/tyranid-datasheet-details.js";
+
+export const TYRANID_DECISION_IDS = Object.freeze({
+  HYPER_ADAPTATIONS: "tyranids.hyper-adaptations",
+  SHADOW_IN_THE_WARP: "tyranids.shadow-in-the-warp"
+});
+
+export const TYRANID_HYPER_ADAPTATIONS = Object.freeze([
+  Object.freeze({
+    id: "swarming-instincts",
+    name: "Swarming Instincts",
+    summary: "Gain Sustained Hits 1 when targeting Infantry or Swarm units."
+  }),
+  Object.freeze({
+    id: "hyper-aggression",
+    name: "Hyper-aggression",
+    summary: "Gain Lethal Hits when targeting Monster or Vehicle units."
+  }),
+  Object.freeze({
+    id: "hive-predators",
+    name: "Hive Predators",
+    summary: "Critical Hits against Character units gain Precision."
+  })
+]);
+
+function normalize(value) {
+  return String(value ?? "").trim().toLowerCase().replace(/[_-]+/g, " ").replace(/\s+/g, " ");
+}
+
+export function getTyranidUnitAbilities(unit) {
+  const datasheetId = unit?.metadata?.datasheetId ?? unit?.datasheetId ?? null;
+  if (typeof datasheetId !== "string" || !datasheetId.startsWith("tyranids:")) return [];
+  const datasheet = getTyranidDatasheetDetails(datasheetId);
+  return Array.isArray(datasheet?.abilities) ? datasheet.abilities : [];
+}
+
+export function unitHasTyranidAbility(unit, abilityName) {
+  const expected = normalize(abilityName);
+  return getTyranidUnitAbilities(unit).some((ability) => normalize(ability?.name) === expected);
+}
+
+export function getTyranidShadowInTheWarpCarriers(state, playerId) {
+  return (Array.isArray(state?.units) ? state.units : []).filter((unit) =>
+    unit.ownerId === playerId &&
+    unit.status === "deployed" &&
+    unitHasTyranidAbility(unit, "Shadow in the Warp")
+  );
+}
+
+function hasRecordedDecision(state, playerId, decisionId) {
+  if (state?.armyRosters?.[playerId]?.battleAbilitySelections?.[decisionId]) return true;
+  if (state?.armyRosters?.[playerId]?.battleAbilityUses?.[decisionId]) return true;
+  return (Array.isArray(state?.history) ? state.history : []).some((event) =>
+    event?.type === "faction_ability.decision_recorded" &&
+    event?.payload?.playerId === playerId &&
+    event?.payload?.decisionId === decisionId
+  );
+}
+
+export function isTyranidPlayer(state, playerId) {
+  const rosterFaction = normalize(state?.armyRosters?.[playerId]?.faction);
+  if (rosterFaction === "tyranids" || rosterFaction === "tyranid") return true;
+  return (Array.isArray(state?.units) ? state.units : []).some((unit) =>
+    unit.ownerId === playerId &&
+    String(unit?.metadata?.datasheetId ?? unit?.datasheetId ?? "").startsWith("tyranids:")
+  );
+}
+
+export function isInvasionFleetRoster(state, playerId) {
+  const roster = state?.armyRosters?.[playerId];
+  return normalize(roster?.faction) === "tyranids" &&
+    normalize(roster?.detachment ?? roster?.detachmentName) === "invasion fleet";
+}
+
+/**
+ * Return reminders for the user's explicitly selected army only.
+ * Ability availability is based on battle roster metadata and datasheet ability
+ * records, not unit names or approximate map positions.
+ */
+export function getTyranidDecisionReminders(state, playerId) {
+  if (!state?.battle || state.battle.status !== "active" || !playerId ||
+      !state.players?.some((player) => player.id === playerId) ||
+      !isTyranidPlayer(state, playerId)) return [];
+
+  const reminders = [];
+  if (state.battle.round === 1 &&
+      state.phase === "command" &&
+      isInvasionFleetRoster(state, playerId) &&
+      !hasRecordedDecision(state, playerId, TYRANID_DECISION_IDS.HYPER_ADAPTATIONS)) {
+    reminders.push({
+      id: TYRANID_DECISION_IDS.HYPER_ADAPTATIONS,
+      playerId,
+      timing: "start-of-first-battle-round",
+      title: "Choose Hyper-adaptations",
+      description: "Select the Invasion Fleet Hyper-adaptation for your army for this battle.",
+      required: true,
+      options: TYRANID_HYPER_ADAPTATIONS
+    });
+  }
+
+  if (state.phase === "command" &&
+      !hasRecordedDecision(state, playerId, TYRANID_DECISION_IDS.SHADOW_IN_THE_WARP) &&
+      getTyranidShadowInTheWarpCarriers(state, playerId).length > 0) {
+    reminders.push({
+      id: TYRANID_DECISION_IDS.SHADOW_IN_THE_WARP,
+      playerId,
+      timing: "either-player-command-phase",
+      title: "Shadow in the Warp",
+      description: "Once per battle, this ability can be unleashed in either player's Command phase. If used, resolve the required enemy Battle-shock tests at the table.",
+      required: false,
+      carriers: getTyranidShadowInTheWarpCarriers(state, playerId).map((unit) => unit.name ?? unit.id)
+    });
+  }
+
+  return reminders;
+}
diff --git a/src/rules/unit-status-summary.js b/src/rules/unit-status-summary.js
new file mode 100644
index 0000000..5d2deac
--- /dev/null
+++ b/src/rules/unit-status-summary.js
@@ -0,0 +1,121 @@
+import { UNIT_STATUS } from "../state/unit.js";
+
+function firstFinite(values) {
+  return values.find((value) => Number.isFinite(value));
+}
+
+export function isUnitBattleShocked(unit) {
+  return unit?.battleShocked === true ||
+    unit?.battleShock?.status === "battle-shocked" ||
+    unit?.battleShock?.active === true;
+}
+
+/**
+ * Return a conservative strength assessment. If surviving model counts are
+ * not tracked, report unknown rather than inferring from aggregate wounds.
+ */
+export function getUnitStrengthAssessment(unit) {
+  const startingStrength = firstFinite([
+    unit?.startingStrength,
+    unit?.strength?.starting,
+    unit?.metadata?.startingStrength,
+    unit?.metadata?.modelCount
+  ]);
+  const currentStrength = firstFinite([
+    unit?.currentStrength,
+    unit?.remainingStrength,
+    unit?.strength?.remaining,
+    unit?.metadata?.currentModelCount
+  ]);
+
+  if (unit?.belowHalfStrength === true || unit?.belowHalfStrength === false) {
+    return { known: true, belowHalfStrength: unit.belowHalfStrength, source: "explicit" };
+  }
+
+
+  // A one-model unit uses remaining Wounds, not a one-model count, to assess
+  // its strength. This must be checked before the generic model-count branch.
+  const isSingleModel = startingStrength === 1 ||
+    (startingStrength == null && unit?.metadata?.modelCount === 1);
+  if (isSingleModel) {
+    const startingWounds = firstFinite([
+      unit?.startingWounds,
+      unit?.profile?.characteristics?.wounds,
+      unit?.profile?.wounds
+    ]);
+    if (Number.isFinite(startingWounds) && startingWounds > 0 &&
+        Number.isFinite(unit?.wounds) && unit.wounds >= 0) {
+      return {
+        known: true,
+        belowHalfStrength: unit.wounds * 2 <= startingWounds,
+        startingStrength: 1,
+        currentStrength: unit.wounds > 0 ? 1 : 0,
+        startingWounds,
+        currentWounds: unit.wounds,
+        source: "single-model-wounds"
+      };
+    }
+    return { known: false, belowHalfStrength: null, source: "untracked-single-model-wounds" };
+  }
+
+  if (Number.isFinite(startingStrength) && startingStrength > 0 &&
+      Number.isFinite(currentStrength) && currentStrength >= 0) {
+    return {
+      known: true,
+      belowHalfStrength: currentStrength * 2 <= startingStrength,
+      startingStrength,
+      currentStrength,
+      source: "model-count"
+    };
+  }
+
+  const models = Array.isArray(unit?.models) ? unit.models : [];
+  const modelStateIsTracked = models.some((model) =>
+    model && typeof model === "object" &&
+    ("status" in model || "destroyed" in model || "isAlive" in model || "wounds" in model)
+  );
+  if (models.length > 0 && modelStateIsTracked) {
+    const remaining = models.filter((model) =>
+      model?.status !== UNIT_STATUS.DESTROYED &&
+      model?.destroyed !== true &&
+      model?.isAlive !== false &&
+      !(Number.isFinite(model?.wounds) && model.wounds <= 0)
+    ).length;
+    const starting = Number.isFinite(startingStrength) && startingStrength > 0
+      ? startingStrength
+      : models.length;
+    return {
+      known: true,
+      belowHalfStrength: remaining * 2 <= starting,
+      startingStrength: starting,
+      currentStrength: remaining,
+      source: "model-state"
+    };
+  }
+
+  return { known: false, belowHalfStrength: null, source: "untracked" };
+}
+
+/**
+ * "requiresTest: null" means the app lacks authoritative model/wound-strength
+ * data and must ask for a table-side check rather than guessing.
+ */
+export function getBattleShockEligibility(unit) {
+  if (!unit || unit.status === UNIT_STATUS.DESTROYED) {
+    return { status: "destroyed", requiresTest: false, known: true };
+  }
+  if (isUnitBattleShocked(unit)) {
+    return { status: "test-required-currently-battle-shocked", requiresTest: true, known: true };
+  }
+  if (unit.status !== UNIT_STATUS.DEPLOYED) {
+    return { status: "not-on-battlefield", requiresTest: false, known: true };
+  }
+  const strength = getUnitStrengthAssessment(unit);
+  if (!strength.known) {
+    return { status: "strength-review-required", requiresTest: null, known: false, strength };
+  }
+  if (strength.belowHalfStrength) {
+    return { status: "test-required-at-or-below-half-strength", requiresTest: true, known: true, strength };
+  }
+  return { status: "no-test-indicated", requiresTest: false, known: true, strength };
+}
diff --git a/src/state/turn-clock.js b/src/state/turn-clock.js
new file mode 100644
index 0000000..5e85b9c
--- /dev/null
+++ b/src/state/turn-clock.js
@@ -0,0 +1,68 @@
+function nonNegativeNumber(value) {
+  return Number.isFinite(value) && value > 0 ? value : 0;
+}
+
+export function getTurnClockState(state = {}) {
+  const stored = state?.timers?.turnClock ?? {};
+  return {
+    elapsedMsByPlayer: { ...(stored.elapsedMsByPlayer ?? {}) },
+    activePlayerId: stored.activePlayerId ?? null,
+    running: stored.running === true,
+    startedAtMs: Number.isFinite(stored.startedAtMs) ? stored.startedAtMs : null
+  };
+}
+
+export function getTurnClockElapsedMs(state = {}, playerId, nowMs = Date.now()) {
+  if (!playerId) return 0;
+  const clock = getTurnClockState(state);
+  let elapsed = nonNegativeNumber(clock.elapsedMsByPlayer[playerId]);
+  if (clock.running && clock.activePlayerId === playerId && Number.isFinite(clock.startedAtMs)) {
+    elapsed += Math.max(0, nowMs - clock.startedAtMs);
+  }
+  return Math.floor(elapsed);
+}
+
+export function formatElapsedTime(milliseconds) {
+  const totalSeconds = Math.floor(nonNegativeNumber(milliseconds) / 1000);
+  const hours = Math.floor(totalSeconds / 3600);
+  const minutes = Math.floor((totalSeconds % 3600) / 60);
+  const seconds = totalSeconds % 60;
+  const pad = (value) => String(value).padStart(2, "0");
+  return hours > 0
+    ? pad(hours) + ":" + pad(minutes) + ":" + pad(seconds)
+    : pad(minutes) + ":" + pad(seconds);
+}
+
+/**
+ * Called only when the active player changes, never for a phase transition.
+ * The previous player's running interval is committed before the next clock
+ * starts, so each player's total remains independently accumulated.
+ */
+export function updateTurnClockForPlayer(state, nextPlayerId, nowMs = Date.now()) {
+  const stored = state?.timers?.turnClock;
+  if (!stored || typeof stored !== "object") return state;
+
+  const clock = getTurnClockState(state);
+  if (clock.activePlayerId === (nextPlayerId ?? null)) return state;
+  const elapsedMsByPlayer = { ...clock.elapsedMsByPlayer };
+  if (clock.running && clock.activePlayerId && Number.isFinite(clock.startedAtMs)) {
+    elapsedMsByPlayer[clock.activePlayerId] =
+      nonNegativeNumber(elapsedMsByPlayer[clock.activePlayerId]) +
+      Math.max(0, nowMs - clock.startedAtMs);
+  }
+
+  const running = clock.running && Boolean(nextPlayerId);
+  return {
+    ...state,
+    timers: {
+      ...(state.timers ?? {}),
+      turnClock: {
+        ...clock,
+        elapsedMsByPlayer,
+        activePlayerId: nextPlayerId ?? null,
+        running,
+        startedAtMs: running ? nowMs : null
+      }
+    }
+  };
+}
