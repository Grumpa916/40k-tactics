+function parseNumericCharacteristic(value) {
+  if (Number.isFinite(value)) return Number(value);
+  const match = String(value ?? "").trim().match(/^(\d+(?:\.\d+)?)\s*(?:[+"″]|in)?$/i);
+  return match ? Number(match[1]) : null;
