+import { getObjectiveControlForPlayer } from "./objective-control-state.js";
+import { getSpatialContext } from "./spatial-context.js";
+import {
+  clamp01,
+  impactLabel,
+  opponentPlayerIds,
+  unitById
+} from "./tactical-context-utils.js";
+
+function objectiveBandWeight(band) {
+  return {
+    close: 1,
+    near: 0.72,
+    mid: 0.3,
+    far: 0.08,
+    "very-far": 0
+  }[band] ?? 0;
+}
+
+function objectiveControlWeight(control) {
+  return {
+    "enemy-controlled": 1,
+    contested: 0.9,
+    "contested-by-others": 0.7,
+    uncontrolled: 0.45,
+    controlled: 0.35
+  }[control] ?? 0.25;
+}
+
+function primaryOwnScoringWeight(control) {
+  return {
+    "enemy-controlled": 0.95,
+    contested: 0.9,
+    "contested-by-others": 0.8,
+    uncontrolled: 0.55,
+    controlled: 0.2
+  }[control] ?? 0.25;
+}
+
+function primaryDenialWeight(control) {
+  return {
+    "enemy-controlled": 1,
+    contested: 0.75,
+    "contested-by-others": 0.65,
+    uncontrolled: 0.15,
+    controlled: 0.05
+  }[control] ?? 0.15;
+}
+
+function scoreForPlayer(state, playerId) {
+  const value = state?.victoryPoints?.[playerId];
+  return Number.isFinite(value) ? Number(value) : 0;
+}
+
+function scoringUrgency(state, playerId) {
+  const round = Math.max(1, Number(state?.battle?.round) || 1);
+  const ownScore = scoreForPlayer(state, playerId);
+  const opponents = opponentPlayerIds(state, playerId);
+  const opponentScore = opponents.length
+    ? Math.max(...opponents.map((id) => scoreForPlayer(state, id)))
+    : ownScore;
+  const gap = ownScore - opponentScore;
+  return clamp01(
+    (round >= 4 ? 0.45 : round >= 3 ? 0.25 : 0.1) +
+    (gap < 0 ? Math.min(0.4, Math.abs(gap) / 30) : 0)
+  );
+}
+
+/**
+ * Objective ownership is authoritative; the unit-to-objective distance is only
+ * approximate battlefield context and never establishes legality or OC.
+ */
+export function getTargetObjectiveImpact(state, { playerId, targetUnitId } = {}) {
+  if (!playerId) throw new TypeError("playerId is required.");
+  if (!targetUnitId) throw new TypeError("targetUnitId is required.");
+
+  const target = unitById(state, targetUnitId);
+  if (!target || target.ownerId === playerId || target.status === "destroyed") {
+    return Object.freeze({
+      score: 0,
+      label: "none",
+      confidence: "low",
+      objectiveId: null,
+      control: null,
+      distance: null,
+      band: "unknown",
+      reason: "No enemy objective context is available for this target."
+    });
+  }
+
+  let spatial = null;
+  try {
+    spatial = getSpatialContext(state, { playerId: target.ownerId });
+  } catch {
+    spatial = null;
+  }
+
+  const nearby = (spatial?.objectiveProximity ?? [])
+    .filter((entry) => entry.unitId === targetUnitId)
+    .map((entry) => {
+      const control = getObjectiveControlForPlayer(state, {
+        playerId,
+        objectiveId: entry.objectiveId
+      });
+      const score = clamp01(objectiveBandWeight(entry.band) * objectiveControlWeight(control));
+      return { ...entry, control, score };
+    })
+    .sort((a, b) => b.score - a.score || a.distance - b.distance || a.objectiveId.localeCompare(b.objectiveId));
+
+  const strongest = nearby[0];
+  if (!strongest || strongest.score <= 0) {
+    return Object.freeze({
+      score: 0,
+      label: "none",
+      confidence: "low",
+      objectiveId: null,
+      control: null,
+      distance: null,
+      band: "unknown",
+      reason: "No nearby objective meaningfully changes this target's mission priority."
+    });
+  }
+
+  const controlPhrase = strongest.control === "enemy-controlled"
+    ? "an opponent-controlled objective"
+    : strongest.control === "controlled"
+      ? "one of your controlled objectives"
+      : strongest.control === "contested"
+        ? "a contested objective"
+        : strongest.control === "uncontrolled"
+          ? "an uncontrolled objective"
+          : "an objective";
+
+  return Object.freeze({
+    score: strongest.score,
+    label: impactLabel(strongest.score),
+    confidence: strongest.band === "close" ? "moderate" : "low",
+    objectiveId: strongest.objectiveId,
+    control: strongest.control,
+    distance: strongest.distance,
+    band: strongest.band,
+    reason: `Target is approximately ${strongest.distance} inches from ${controlPhrase}; tabletop position and actual OC remain authoritative.`
+  });
+}
+
+/**
+ * Translate objective context into Primary board-control and score-denial value.
+ * It does not claim that a particular Primary card scores from this objective.
+ */
+export function getTargetPrimaryMissionImpact(state, { playerId, targetUnitId } = {}) {
+  const objective = getTargetObjectiveImpact(state, { playerId, targetUnitId });
+  if (!objective.objectiveId || objective.score <= 0) {
+    return Object.freeze({
+      score: 0,
+      label: "none",
+      confidence: "low",
+      objectiveId: null,
+      ownScoringValue: 0,
+      denyScoringValue: 0,
+      urgency: scoringUrgency(state, playerId),
+      reason: "No objective-linked Primary scoring impact is established for this target."
+    });
+  }
+
+  const ownScoringValue = clamp01(objective.score * primaryOwnScoringWeight(objective.control));
+  const denyScoringValue = clamp01(objective.score * primaryDenialWeight(objective.control));
+  const urgency = scoringUrgency(state, playerId);
+  const score = clamp01(
+    0.48 * ownScoringValue +
+    0.38 * denyScoringValue +
+    0.14 * urgency * objective.score
+  );
+
+  return Object.freeze({
+    score,
+    label: impactLabel(score),
+    confidence: objective.confidence,
+    objectiveId: objective.objectiveId,
+    control: objective.control,
+    ownScoringValue,
+    denyScoringValue,
+    urgency,
+    reason: `${objective.reason} Removing or degrading this unit may change Primary board control or deny scoring, but the physical mission card and actual OC determine the score.`
+  });
+}
diff --git a/src/rules/tactical-secondary-target-impact.js b/src/rules/tactical-secondary-target-impact.js
new file mode 100644
index 0000000..16c7888
--- /dev/null
+++ b/src/rules/tactical-secondary-target-impact.js
@@ -0,0 +1,172 @@
+import {
+  getSecondaryMissionHistory,
+  SECONDARY_MISSION_STATUS
+} from "./secondary-mission-lifecycle.js";
+import { isUnitBattleShocked } from "./unit-status-summary.js";
+import {
+  clamp01,
+  distanceBetween,
+  hasKeyword,
+  impactLabel,
+  opponentPlayerIds,
+  unitById,
+  unitPosition
+} from "./tactical-context-utils.js";
+
+const TABLE_CENTRE = Object.freeze({ x: 30, y: 22 });
+
+function activeSecondaryEntries(state, playerId) {
+  if (!playerId) return [];
+  return getSecondaryMissionHistory(state, playerId)
+    .filter((entry) => entry.status === SECONDARY_MISSION_STATUS.ACTIVE);
+}
+
+function definitionSlug(definition) {
+  return String(definition?.id ?? "")
+    .replace(/^secondary-/, "")
+    .trim()
+    .toLowerCase();
+}
+
+function structuredDestructionRelevance(definition, targetUnitId) {
+  const conditions = Array.isArray(definition?.conditions) ? definition.conditions : [];
+  return conditions.some((condition) =>
+    condition?.evidence === "unit-destruction" &&
+    condition?.args?.unitId === targetUnitId &&
+    condition?.args?.expected !== false
+  );
+}
+
+function centreGroundRelevance(state, target) {
+  if (!target || target.status === "destroyed") return null;
+  if (isUnitBattleShocked(target) || hasKeyword(state, target, "aircraft")) return null;
+  const distance = distanceBetween(unitPosition(target), TABLE_CENTRE);
+  if (!Number.isFinite(distance) || distance > 9) return null;
+  const score = distance <= 3 ? 1 : distance <= 6 ? 0.82 : 0.3;
+  return { score, distance };
+}
+
+/**
+ * Active secondary cards influence target ranking only when their stored rules
+ * are verified or when they contain an explicit structured destruction target.
+ * Draft/unverified card text remains visible but cannot silently alter advice.
+ */
+export function getTargetSecondaryMissionImpact(state, { playerId, targetUnitId } = {}) {
+  if (!playerId) throw new TypeError("playerId is required.");
+  if (!targetUnitId) throw new TypeError("targetUnitId is required.");
+
+  const target = unitById(state, targetUnitId);
+  if (!target || target.ownerId === playerId || target.status === "destroyed") {
+    return Object.freeze({
+      score: 0,
+      label: "none",
+      confidence: "low",
+      scoringSignals: Object.freeze([]),
+      denialSignals: Object.freeze([]),
+      unresolvedMissions: Object.freeze([]),
+      reason: "No active secondary target context is available."
+    });
+  }
+
+  const own = activeSecondaryEntries(state, playerId);
+  const opponent = opponentPlayerIds(state, playerId)
+    .flatMap((id) => activeSecondaryEntries(state, id));
+  const scoringSignals = [];
+  const denialSignals = [];
+  const unresolvedMissions = [];
+
+  for (const entry of own) {
+    const definition = entry.definition ?? {};
+    const slug = definitionSlug(definition);
+    const verified = definition.rulesVerified === true;
+
+    if (structuredDestructionRelevance(definition, targetUnitId)) {
+      scoringSignals.push({
+        missionId: definition.id,
+        missionName: definition.name ?? definition.id,
+        score: 1,
+        confidence: verified ? "high" : "moderate",
+        reason: "This active secondary contains a structured destruction condition for the selected target."
+      });
+      continue;
+    }
+
+    if (verified && slug === "assassination" && hasKeyword(state, target, "character")) {
+      scoringSignals.push({
+        missionId: definition.id,
+        missionName: definition.name ?? "Assassination",
+        score: 1,
+        confidence: "high",
+        reason: "Active Assassination makes this enemy CHARACTER a directly scoring-relevant target."
+      });
+      continue;
+    }
+
+    if (verified && slug === "centre-ground") {
+      const relevance = centreGroundRelevance(state, target);
+      if (relevance) {
+        scoringSignals.push({
+          missionId: definition.id,
+          missionName: definition.name ?? "Centre Ground",
+          score: relevance.score,
+          confidence: relevance.distance <= 3 ? "moderate" : "low",
+          reason: `This enemy is approximately ${relevance.distance.toFixed(1)} inches from battlefield centre; removing it may help clear Centre Ground. Exact tabletop distance remains authoritative.`
+        });
+      }
+      continue;
+    }
+
+    if (!verified) unresolvedMissions.push(definition.name ?? definition.id ?? "Unverified secondary");
+  }
+
+  for (const entry of opponent) {
+    const definition = entry.definition ?? {};
+    const slug = definitionSlug(definition);
+    const verified = definition.rulesVerified === true;
+
+    if (verified && slug === "centre-ground") {
+      const relevance = centreGroundRelevance(state, target);
+      if (relevance) {
+        denialSignals.push({
+          missionId: definition.id,
+          missionName: definition.name ?? "Centre Ground",
+          score: relevance.score,
+          confidence: relevance.distance <= 3 ? "moderate" : "low",
+          reason: `This opponent unit is approximately ${relevance.distance.toFixed(1)} inches from battlefield centre and may be contributing to their Centre Ground scoring.`
+        });
+      }
+      continue;
+    }
+
+    if (!verified) unresolvedMissions.push(definition.name ?? definition.id ?? "Unverified opponent secondary");
+  }
+
+  const bestScoring = scoringSignals.reduce((best, signal) => Math.max(best, signal.score), 0);
+  const bestDenial = denialSignals.reduce((best, signal) => Math.max(best, signal.score), 0);
+  const score = clamp01(Math.max(
+    bestScoring,
+    0.8 * bestDenial,
+    0.65 * bestScoring + 0.35 * bestDenial
+  ));
+  const evidence = [...scoringSignals, ...denialSignals];
+  const confidence = evidence.some((signal) => signal.confidence === "high")
+    ? "high"
+    : evidence.some((signal) => signal.confidence === "moderate")
+      ? "moderate"
+      : "low";
+
+  const reasonParts = evidence.map((signal) => signal.reason);
+  if (unresolvedMissions.length) {
+    reasonParts.push(`${[...new Set(unresolvedMissions)].join(", ")} are active but their target-specific effect is not used for ranking because the stored card rules are not verified.`);
+  }
+
+  return Object.freeze({
+    score,
+    label: impactLabel(score),
+    confidence,
+    scoringSignals: Object.freeze(scoringSignals.map((signal) => Object.freeze({ ...signal }))),
+    denialSignals: Object.freeze(denialSignals.map((signal) => Object.freeze({ ...signal }))),
+    unresolvedMissions: Object.freeze([...new Set(unresolvedMissions)]),
+    reason: reasonParts.join(" ") || "No verified active secondary directly changes this target's priority."
+  });
+}
diff --git a/src/rules/tactical-shooting-comparison.js b/src/rules/tactical-shooting-comparison.js
new file mode 100644
index 0000000..6799bda
--- /dev/null
+++ b/src/rules/tactical-shooting-comparison.js
@@ -0,0 +1,166 @@
+import { getDamageOutcomeDistribution } from "./damage-outcome-distribution.js";
+import { getShootingTargetPriorities } from "./tactical-shooting-targets.js";
+import { getTargetStrategicContext } from "./tactical-target-context.js";
+
+function unitById(state, unitId) {
+  return (Array.isArray(state?.units) ? state.units : [])
+    .find((unit) => unit?.id === unitId) ?? null;
+}
+
+function probabilityAtLeast(distribution, threshold) {
+  if (!distribution || !Array.isArray(distribution.outcomes) || !Number.isFinite(threshold)) return null;
+  return distribution.outcomes
+    .filter((outcome) => outcome.damage >= threshold)
+    .reduce((sum, outcome) => sum + outcome.probability, 0);
+}
+
+function probabilityAnyDamage(distribution) {
+  if (!distribution || !Array.isArray(distribution.outcomes)) return null;
+  const noDamage = distribution.outcomes
+    .filter((outcome) => outcome.damage <= 0)
+    .reduce((sum, outcome) => sum + outcome.probability, 0);
+  return Math.max(0, Math.min(1, 1 - noDamage));
+}
+
+function strategicRecommendation({ strategicContext, impactClassification, destructionProbability, expectedDamage }) {
+  if (strategicContext.secondary.score >= 0.7) {
+    return "Priority target: destroying or degrading this unit has strong verified active-secondary impact in addition to its combat value.";
+  }
+  if (strategicContext.primary.score >= 0.7) {
+    return "Priority target: this unit has strong objective-linked Primary scoring or denial value; confirm actual OC and mission conditions at the table.";
+  }
+  if (strategicContext.threat.score >= 0.7) {
+    return "Priority target: recorded combat history identifies this unit as a proven threat worth suppressing.";
+  }
+  if (destructionProbability >= 0.8) {
+    return "Strong offensive opportunity with a likely destruction result; compare its mission value before committing the activation.";
+  }
+  if (strategicContext.primary.score >= 0.4 || strategicContext.secondary.score >= 0.4) {
+    return "Mission-relevant target: its scoring impact may justify attacking it even if another target offers slightly better raw damage.";
+  }
+  if (strategicContext.threat.score >= 0.4) {
+    return "Threat-suppression candidate: this unit has meaningful recorded combat impact.";
+  }
+  if (impactClassification === "possible-destruction") {
+    return "Possible destruction opportunity; weigh the kill chance against mission value and other available targets.";
+  }
+  if (impactClassification === "likely-severe-degradation") {
+    return "Strong degradation opportunity; expected damage is at least half the target's remaining wounds.";
+  }
+  if (Number.isFinite(expectedDamage) && expectedDamage > 0) {
+    return "Limited baseline impact; prefer this target only if its mission or threat value justifies the shooting commitment.";
+  }
+  return "Insufficient combat or strategic evidence for a stronger recommendation.";
+}
+
+/**
+ * Stable view-model contract for the tablet "Compare your targets" surface.
+ *
+ * The existing Shooting target resolver remains untouched. This decision layer
+ * enriches its candidates with mission context, active verified secondaries,
+ * recorded opponent threat and probability detail, then ranks the candidates
+ * for advice. The UI can render this without duplicating Tactical Advisor math.
+ */
+export function getShootingTargetComparison(state, {
+  playerId,
+  attackerId,
+  weapon = null
+} = {}) {
+  const attacker = unitById(state, attackerId);
+  const base = getShootingTargetPriorities(state, { playerId, attackerId, weapon });
+
+  const comparisons = base.priorities.map((item) => {
+    const target = unitById(state, item.targetUnitId);
+    const strategicContext = getTargetStrategicContext(state, {
+      playerId,
+      targetUnitId: item.targetUnitId
+    });
+
+    let distribution = null;
+    if (target && weapon?.characteristics &&
+        (attacker?.characteristics ?? attacker?.profile?.characteristics) &&
+        (target?.characteristics ?? target?.profile?.characteristics)) {
+      try {
+        distribution = getDamageOutcomeDistribution({ attacker, target, weapon });
+      } catch {
+        distribution = null;
+      }
+    }
+
+    const expectedDamage = item.expectedDamage;
+    const expectedDamageThreshold = Number.isFinite(expectedDamage) && expectedDamage > 0
+      ? Math.max(1, Math.ceil(expectedDamage))
+      : 1;
+    const severeDamageThreshold = Number.isFinite(target?.wounds) && target.wounds > 0
+      ? Math.max(1, Math.ceil(target.wounds * 0.5))
+      : null;
+    const probabilityAnyDamageValue = probabilityAnyDamage(distribution);
+    const probabilityAtLeastExpectedDamage = probabilityAtLeast(distribution, expectedDamageThreshold);
+    const severeDamageProbability = severeDamageThreshold == null
+      ? null
+      : probabilityAtLeast(distribution, severeDamageThreshold);
+
+    const primaryMissionPoints = strategicContext.primary.score * 3.5;
+    const secondaryMissionPoints = strategicContext.secondary.score * 3.5;
+    const threatPoints = strategicContext.threat.score * 2.25;
+    const objectiveContextPoints = strategicContext.objective.score * 0.75;
+    const strategicPoints = primaryMissionPoints + secondaryMissionPoints + threatPoints + objectiveContextPoints;
+    const decisionScore = item.priority + strategicPoints;
+
+    return {
+      ...item,
+      targetName: target?.name ?? item.targetUnitId,
+      probabilityAnyDamage: probabilityAnyDamageValue,
+      expectedDamageThreshold,
+      probabilityAtLeastExpectedDamage,
+      severeDamageThreshold,
+      severeDamageProbability,
+      objectiveImpact: strategicContext.objective,
+      primaryMissionImpact: strategicContext.primary,
+      secondaryMissionImpact: strategicContext.secondary,
+      recentThreat: strategicContext.threat,
+      strategicContext,
+      decisionScore,
+      decisionBreakdown: Object.freeze({
+        baselineTargetPriority: item.priority,
+        primaryMissionPoints,
+        secondaryMissionPoints,
+        threatPoints,
+        objectiveContextPoints,
+        strategicPoints,
+        weights: Object.freeze({
+          primaryMission: 3.5,
+          secondaryMission: 3.5,
+          threat: 2.25,
+          objectiveContext: 0.75
+        })
+      }),
+      recommendation: strategicRecommendation({
+        strategicContext,
+        impactClassification: item.impactClassification,
+        destructionProbability: item.destructionProbability,
+        expectedDamage
+      }),
+      assumptions: Object.freeze([
+        "Battlefield distances are approximate and tabletop measurement remains authoritative.",
+        "Probabilities use saved profiles and known weapon characteristics only.",
+        "Mission impact never awards VP automatically.",
+        "Unverified secondary-card text is not used to change target ranking."
+      ])
+    };
+  }).sort((a, b) =>
+    b.decisionScore - a.decisionScore ||
+    (a.targetDistance ?? Infinity) - (b.targetDistance ?? Infinity) ||
+    a.targetUnitId.localeCompare(b.targetUnitId)
+  );
+
+  return Object.freeze({
+    playerId,
+    attackerId,
+    weaponId: weapon?.id ?? null,
+    comparisons: Object.freeze(comparisons.map((item, index) => Object.freeze({
+      ...item,
+      rank: index + 1
+    })))
+  });
+}
diff --git a/src/rules/tactical-target-context.js b/src/rules/tactical-target-context.js
new file mode 100644
index 0000000..46ab084
--- /dev/null
+++ b/src/rules/tactical-target-context.js
@@ -0,0 +1,38 @@
+import {
+  getTargetObjectiveImpact,
+  getTargetPrimaryMissionImpact
+} from "./tactical-objective-impact.js";
+import { getTargetSecondaryMissionImpact } from "./tactical-secondary-target-impact.js";
+import { getTargetThreatImpact } from "./tactical-threat-impact.js";
+import { clamp01, impactLabel } from "./tactical-context-utils.js";
+
+export {
+  getTargetObjectiveImpact,
+  getTargetPrimaryMissionImpact,
+  getTargetSecondaryMissionImpact,
+  getTargetThreatImpact
+};
+
+export function getTargetStrategicContext(state, options = {}) {
+  const objective = getTargetObjectiveImpact(state, options);
+  const primary = getTargetPrimaryMissionImpact(state, options);
+  const secondary = getTargetSecondaryMissionImpact(state, options);
+  const threat = getTargetThreatImpact(state, options);
+  const score = clamp01(
+    0.32 * primary.score +
+    0.28 * secondary.score +
+    0.22 * threat.score +
+    0.18 * objective.score
+  );
+  return Object.freeze({
+    score,
+    label: impactLabel(score),
+    objective,
+    primary,
+    secondary,
+    threat,
+    reason: [primary.reason, secondary.reason, threat.reason]
+      .filter(Boolean)
+      .join(" ")
+  });
+}
diff --git a/src/rules/tactical-threat-impact.js b/src/rules/tactical-threat-impact.js
new file mode 100644
index 0000000..fa7dad7
--- /dev/null
+++ b/src/rules/tactical-threat-impact.js
@@ -0,0 +1,75 @@
+import { getCombatHistorySummary } from "./combat-history-summary.js";
+import { clamp01, impactLabel, unitById } from "./tactical-context-utils.js";
+
+/**
+ * Summarize authoritative opponent combat events caused by one target unit.
+ * Damage, charges and activations come from state.history rather than map
+ * inference. Recent rounds are weighted slightly more heavily.
+ */
+export function getTargetThreatImpact(state, { playerId, targetUnitId } = {}) {
+  if (!playerId) throw new TypeError("playerId is required.");
+  if (!targetUnitId) throw new TypeError("targetUnitId is required.");
+
+  const target = unitById(state, targetUnitId);
+  if (!target || target.ownerId === playerId || target.status === "destroyed") {
+    return Object.freeze({
+      score: 0,
+      label: "none",
+      damageDealt: 0,
+      attacks: 0,
+      charges: 0,
+      fights: 0,
+      activations: 0,
+      reason: "No opponent threat history is available."
+    });
+  }
+
+  let summary = null;
+  try {
+    summary = getCombatHistorySummary(state, { playerId });
+  } catch {
+    summary = null;
+  }
+
+  const currentRound = Math.max(1, Number(state?.battle?.round) || 1);
+  let damageDealt = 0;
+  let attacks = 0;
+  let charges = 0;
+  let fights = 0;
+  let activations = 0;
+
+  for (const action of summary?.opponentActions ?? []) {
+    if (action.actorId !== targetUnitId) continue;
+    const actionRound = Number.isFinite(action.round) ? action.round : currentRound;
+    const recency = actionRound >= currentRound - 1 ? 1 : 0.6;
+    if (action.type === "combat.attack_resolved") {
+      attacks += recency;
+      damageDealt += Math.max(0, Number(action.actualDamage) || 0) * recency;
+      if (action.phase === "fight") fights += recency;
+    } else if (action.type === "charge.outcome_recorded") {
+      charges += recency;
+    } else if (action.type === "fight.unit_activated" || action.type === "shooting.unit_activated") {
+      activations += recency;
+    }
+  }
+
+  const damageScore = Math.min(0.7, damageDealt / 12);
+  const actionScore = Math.min(0.3, attacks * 0.06 + charges * 0.12 + fights * 0.06 + activations * 0.04);
+  const score = clamp01(damageScore + actionScore);
+  const roundedDamage = Math.round(damageDealt * 10) / 10;
+
+  const reason = score <= 0
+    ? "No recorded opponent combat events make this target a higher immediate threat."
+    : `Recorded recent history: approximately ${roundedDamage} damage, ${Math.round(attacks)} attack event${Math.round(attacks) === 1 ? "" : "s"}, ${Math.round(charges)} successful charge${Math.round(charges) === 1 ? "" : "s"}, and ${Math.round(fights)} Fight attack${Math.round(fights) === 1 ? "" : "s"}.`;
+
+  return Object.freeze({
+    score,
+    label: impactLabel(score),
+    damageDealt: roundedDamage,
+    attacks: Math.round(attacks),
+    charges: Math.round(charges),
+    fights: Math.round(fights),
+    activations: Math.round(activations),
+    reason
+  });
+}
